{
  "name": "ptlc-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A console for the Zenon ptlc contract as a static page: every call, through a key the page holds or a wallet, against a node or a chain that runs in the tab.",
  "scripts": {
    "sim": "sh ../scripts/build-sim.sh",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build:offline": "vite build --mode offline --outDir dist-offline"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@scure/bip39": "^1.6.0",
    "bech32": "^2.0.0",
    "mermaid": "^11.4.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.3.1",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.1.1"
  }
}
